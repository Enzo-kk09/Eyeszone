{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "EYESZONE: abrir loja",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/js/serve.mjs",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "node",
      "windows": {
        "runtimeExecutable": "${env:LOCALAPPDATA}/Temp/eyeszone-tools/node-v22.23.3-win-x64/node.exe"
      },
      "console": "internalConsole",
      "outputCapture": "std",
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "pattern": "EYESZONE: (https?://\\S+)",
        "uriFormat": "%s/index.html",
        "action": "openExternally"
      }
    }
  ]
}
